<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- 1. Полноэкранный Backdrop текущего фильма -->
    <ImageView
        android:id="@+id/hero_backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Горизонтальный градиент: затемнение слева для четкости текста -->
    <View
        android:id="@+id/scrim_horizontal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/scrim_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 3. Вертикальный градиент: затемнение снизу для полки постеров -->
    <View
        android:id="@+id/scrim_vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/scrim_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 3.1. Поле поиска по каталогу (отображается в режиме ПОИСК) -->
    <LinearLayout
        android:id="@+id/search_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="92dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="64dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="600dp">

        <LinearLayout
            android:id="@+id/search_input_frame"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_search_input"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_secondary" />

            <EditText
                android:id="@+id/search_edit_text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Поиск фильмов и сериалов..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/search_clear_btn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3.2. Название текущей подборки (В тренде, Новинки, В эфире, Фильмы, Сериалы, Избранное, История) -->
    <TextView
        android:id="@+id/section_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="92dp"
        android:layout_marginTop="32dp"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="В тренде" />

    <!-- 4. Информационный блок текущего фильма (Spotlight) -->
    <LinearLayout
        android:id="@+id/info_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="92dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="64dp"
        android:layout_marginBottom="16dp"
        android:gravity="bottom"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/poster_grid_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/section_header"
        app:layout_constraintWidth_max="740dp">

        <!-- Название фильма -->
        <TextView
            android:id="@+id/hero_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold"
            tools:text="Интерстеллар" />

        <!-- Бейджи: Прогресс, Возраст, Год, Рейтинг, Хронометраж -->
        <LinearLayout
            android:id="@+id/hero_badges_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/badge_watch_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_badge_rounded"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="▶ Просмотрено 45:10" />

            <TextView
                android:id="@+id/badge_age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_badge_rounded"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="16+" />

            <TextView
                android:id="@+id/badge_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:textColor="#FFC107"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="★ 8.6" />

            <TextView
                android:id="@+id/badge_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="2014" />

            <TextView
                android:id="@+id/badge_country"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="США, Великобритания" />

            <TextView
                android:id="@+id/badge_runtime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="169 мин" />

            <TextView
                android:id="@+id/badge_original_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="Interstellar" />

        </LinearLayout>

        <!-- Краткое описание сюжета -->
        <TextView
            android:id="@+id/hero_overview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="4"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="#D5D5D5"
            android:textSize="15sp"
            tools:text="Когда засуха, пыльные бури и вымирание растений приводят человечество к продовольственному кризису, коллектив исследователей и учёных отправляется сквозь червоточину..." />

    </LinearLayout>

    <!-- 5. Тот самый "1 ряд" постеров (HorizontalGridView) внизу экрана -->
    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/poster_grid_view"
        android:layout_width="0dp"
        android:layout_height="225dp"
        android:layout_marginStart="80dp"
        android:layout_marginBottom="20dp"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 6. Индикатор загрузки -->
    <ProgressBar
        android:id="@+id/loading_progress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="@color/brand_primary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/poster_grid_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/poster_grid_view" />

    <!-- 7. Сообщение, если список пуст -->
    <TextView
        android:id="@+id/empty_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_sources_found"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/poster_grid_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/poster_grid_view" />

    <!-- 8. Контейнер экрана Настроек (отображается при выборе категории Настройки) -->
    <ScrollView
        android:id="@+id/settings_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="96dp"
        android:layout_marginEnd="48dp"
        android:paddingTop="36dp"
        android:paddingBottom="36dp"
        android:fadeScrollbars="false"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="750dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Настройки"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- 1. Настройка персонального TMDB API ключа -->
            <LinearLayout
                android:id="@+id/card_setting_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@+id/side_menu_recycler"
                android:nextFocusDown="@+id/card_setting_clear_history"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="Персональный ключ TMDB API"
                    android:textColor="@color/color_menu_item_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_api_key_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:duplicateParentState="true"
                    android:text="Используется встроенный ключ"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 2. Очистить историю просмотров -->
            <LinearLayout
                android:id="@+id/card_setting_clear_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@+id/side_menu_recycler"
                android:nextFocusUp="@+id/card_setting_api_key"
                android:nextFocusDown="@+id/card_setting_clear_favorites"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="Очистить историю просмотров"
                    android:textColor="@color/color_menu_item_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:duplicateParentState="true"
                    android:text="Удалить все сохраненные тайминги и позиции серий"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 3. Очистить Избранное -->
            <LinearLayout
                android:id="@+id/card_setting_clear_favorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@+id/side_menu_recycler"
                android:nextFocusUp="@+id/card_setting_clear_history"
                android:nextFocusDown="@+id/card_setting_audio_compression"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="Очистить Избранное"
                    android:textColor="@color/color_menu_item_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:duplicateParentState="true"
                    android:text="Удалить все фильмы и сериалы из списка избранного"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 4. Автовыравнивание звука (+3 dB) -->
            <LinearLayout
                android:id="@+id/card_setting_audio_compression"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@+id/side_menu_recycler"
                android:nextFocusUp="@+id/card_setting_clear_favorites"
                android:nextFocusDown="@+id/card_setting_tv_channels"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="Автовыравнивание звука (+3 dB)"
                    android:textColor="@color/color_menu_item_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_audio_compression_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:duplicateParentState="true"
                    android:text="Включено (компрессия диапазона и мягкое усиление)"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 5. Каналы Android TV -->
            <LinearLayout
                android:id="@+id/card_setting_tv_channels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@+id/side_menu_recycler"
                android:nextFocusUp="@+id/card_setting_audio_compression"
                android:nextFocusDown="@+id/card_setting_update"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="Каналы главного экрана Android TV"
                    android:textColor="@color/color_menu_item_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_tv_channels_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:duplicateParentState="true"
                    android:text="Обновить каналы: «В тренде», «Избранное», «История просмотров»"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 6. Настройка обновления приложения -->
            <LinearLayout
                android:id="@+id/card_setting_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@+id/side_menu_recycler"
                android:nextFocusUp="@+id/card_setting_tv_channels"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="Обновление приложения"
                    android:textColor="@color/color_menu_item_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_version_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:duplicateParentState="true"
                    android:text="Текущая версия • Нажмите для проверки"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/progress_update_download"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progressDrawable="@drawable/bg_watch_progress"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 9. Боковое быстрое меню в стиле NUM (выдвигается при уходе влево) -->
    <LinearLayout
        android:id="@+id/side_menu_container"
        android:layout_width="68dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_side_menu"
        android:elevation="20dp"
        android:orientation="vertical"
        android:paddingTop="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Заголовок приложения в боковом меню (вровень с пунктами меню) -->
        <TextView
            android:id="@+id/menu_app_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="14dp"
            android:alpha="0"
            android:gravity="start|center_vertical"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="RuVK Hub" />

        <!-- Вертикальный список пунктов меню -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/side_menu_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:descendantFocusability="afterDescendants"
            android:focusable="false" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
