<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/details_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- 1. Полноэкранный Backdrop фильма -->
    <ImageView
        android:id="@+id/details_hero_backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Горизонтальный градиент: затемнение слева для четкости текста -->
    <View
        android:id="@+id/details_scrim_horizontal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/scrim_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 3. Вертикальный градиент: затемнение снизу для полки источников -->
    <View
        android:id="@+id/details_scrim_vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/scrim_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 4. Вертикальный постер фильма (слева) -->
    <FrameLayout
        android:id="@+id/poster_card"
        android:layout_width="190dp"
        android:layout_height="280dp"
        android:layout_marginStart="56dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_poster_details"
        android:clipToOutline="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/details_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <!-- 5. Информационный блок фильма (справа от постера) -->
    <LinearLayout
        android:id="@+id/info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="56dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/poster_card"
        app:layout_constraintTop_toTopOf="@+id/poster_card">

        <!-- Название фильма -->
        <TextView
            android:id="@+id/details_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            tools:text="Интерстеллар" />

        <!-- Оригинальное название -->
        <TextView
            android:id="@+id/details_original_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="Interstellar" />

        <!-- Бейджи: Возраст, Рейтинг, Год, Хронометраж -->
        <LinearLayout
            android:id="@+id/badges_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/badge_age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_badge_rounded"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="16+" />

            <TextView
                android:id="@+id/badge_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:textColor="#FFC107"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="★ 8.6" />

            <TextView
                android:id="@+id/badge_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="2014" />

            <TextView
                android:id="@+id/badge_runtime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="169 мин" />
        </LinearLayout>

        <!-- Синопсис / Описание сюжета -->
        <TextView
            android:id="@+id/details_overview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="4"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="#D5D5D5"
            android:textSize="14sp"
            tools:text="Когда засуха, пыльные бури и вымирание растений приводят человечество к продовольственному кризису, коллектив исследователей и учёных отправляется сквозь червоточину в поисках нового дома..." />

        <!-- 3 кнопки действий в стиле NUM -->
        <LinearLayout
            android:id="@+id/actions_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_watch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_action_btn"
                android:clickable="true"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="10dp"
                android:drawableTint="@color/color_action_btn_text"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:paddingTop="10dp"
                android:paddingEnd="22dp"
                android:paddingBottom="10dp"
                android:text="Смотреть"
                android:textColor="@color/color_action_btn_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_trailer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_action_btn"
                android:clickable="true"
                android:drawableStart="@drawable/ic_trailer"
                android:drawablePadding="10dp"
                android:drawableTint="@color/color_action_btn_text"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp"
                android:paddingBottom="10dp"
                android:text="Трейлер"
                android:textColor="@color/color_action_btn_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_favorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_action_btn"
                android:clickable="true"
                android:drawableStart="@drawable/ic_favorite_border"
                android:drawablePadding="10dp"
                android:drawableTint="@color/color_action_btn_text"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp"
                android:paddingBottom="10dp"
                android:text="В избранное"
                android:textColor="@color/color_action_btn_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 6. Заголовок полки источников -->
    <TextView
        android:id="@+id/sources_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginBottom="8dp"
        android:text="Источники (Rutube / VK Video)"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/sources_frame"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 7. Контейнер полки источников видео -->
    <FrameLayout
        android:id="@+id/sources_frame"
        android:layout_width="0dp"
        android:layout_height="115dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Горизонтальная полка карточек найденных видео -->
        <androidx.leanback.widget.HorizontalGridView
            android:id="@+id/sources_grid_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="56dp"
            android:paddingEnd="56dp" />

        <!-- Индикатор фонового поиска источников -->
        <LinearLayout
            android:id="@+id/sources_progress_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="visible">

            <ProgressBar
                android:id="@+id/sources_progress"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminateTint="@color/brand_primary" />

            <TextView
                android:id="@+id/sources_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Поиск видео на Rutube и VK Video..."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Сообщение, если ничего не найдено -->
        <TextView
            android:id="@+id/sources_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Видео не найдены на Rutube и VK Video"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
