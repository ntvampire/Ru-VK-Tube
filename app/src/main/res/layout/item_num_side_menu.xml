<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menu_item_container"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:layout_marginStart="8dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_menu_item_selector"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <!-- Векторная монохромная иконка пункта меню (наследует фокус от контейнера) -->
    <ImageView
        android:id="@+id/menu_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="@string/app_name"
        android:duplicateParentState="true"
        app:tint="@color/color_menu_item_icon" />

    <!-- Название пункта меню (наследует фокус от контейнера) -->
    <TextView
        android:id="@+id/menu_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/color_menu_item_text"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
